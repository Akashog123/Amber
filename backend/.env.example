# Recall.ai — leave RECALL_API_KEY empty to run with replay.py only
RECALL_API_KEY=
RECALL_REGION=us-west-2
# Transcription: "recall" (English only) or "deepgram" (nova-3, en-IN, boosted keyterms).
# For deepgram, add the Deepgram key + Project ID in the Recall dashboard -> Transcription (key role: Member+).
RECALL_TRANSCRIBER=recall
# multi = English + Hindi as spoken (code-switching; Hindi comes out in Devanagari). en-IN = Indian English only:
# real Hindi speech gets transcribed as English-sounding words (seen live), so Amber never hears it as Hindi.
DEEPGRAM_LANGUAGE=multi
DEEPGRAM_ENDPOINTING_MS=300
# Only used for local checks (scripts), Recall uses the dashboard copy
DEEPGRAM_API_KEY=
# Public tunnel URL to this backend (ngrok/cloudflared), no trailing slash
PUBLIC_URL=https://xxxx.ngrok-free.app
# Random string; appended to the webhook URL Recall calls
WEBHOOK_TOKEN=change-me
# 1 = let tunneled requests reach the operator API (no auth: anyone with the link can drive Amber)
SHARE_PUBLIC=0
# 0 = don't load the mock procurement/equipment records on start
SEED_RECORDS=1
# LLM: any OpenAI-compatible server (local proxy, OpenAI, Groq, LM Studio). Used first when set.
# Base URL must include /v1. Leave LLM_BASE_URL empty to use Gemini only.
LLM_BASE_URL=http://localhost:8317/v1
LLM_API_KEY=
LLM_MODEL=gemma4:31b,gpt-6-luna@low,gemini-3.5-flash-lite
# Seconds per call before falling back; max tokens leaves room for models that reason first
LLM_TIMEOUT=10
LLM_MAX_TOKENS=300
# none / low / medium / high (sent as reasoning_effort); empty = model default.
# Leave EMPTY for gemma4: any value (even none) turns its thinking on and adds ~1s+
LLM_REASONING_EFFORT=
# Optional fallback after the proxy (leave empty to skip)
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# Reply voice model (speed matters): eleven_flash_v2_5 | eleven_turbo_v2_5 | eleven_v3_conversational | eleven_v4
# Filler model (cached, speed irrelevant); empty = same as ELEVENLABS_MODEL
ELEVENLABS_MODEL=eleven_turbo_v2_5
ELEVENLABS_FILLER_MODEL=
# Empty = Monika Sogam (energetic, Indian English, also speaks Hindi). Changing it re-synthesizes the fillers.
ELEVENLABS_VOICE_ID=
SMTP_USER=
SMTP_PASS=
# Seconds of asker silence before Amber answers
AMBER_DEBOUNCE=0.7
# Override if Google retires the default model
GEMINI_MODEL=gemini-3.5-flash
# Record tagging: write notes at >= AUTO_WRITE confidence, ask in chat between CONFIRM_MIN and AUTO_WRITE
AMBER_AUTO_WRITE=0.8
AMBER_CONFIRM_MIN=0.5
# New human lines between extraction passes
AMBER_EXTRACT_EVERY=4
# Reminders: send this long before the due date; demo knob sends N minutes after the meeting instead
AMBER_REMINDER_LEAD_HOURS=24
AMBER_DEMO_REMINDER_MINUTES=
# Screen-share frames to Amber over a Recall websocket (2 fps PNGs); she looks at the latest one only when asked
# about the screen. 1 = on. Needs the tunnel to pass websockets (cloudflared does).
AMBER_SCREEN_VISION=
# MOM prompt cap for very long meetings (characters of transcript, latest part kept)
AMBER_MOM_MAX_CHARS=80000
# Barge-in: someone speaking this long over Amber stops her ("stop"/"wait" stop her at once). "Yeah" is ~0.3 s.
AMBER_BARGE_IN_SEC=0.7
# Amber's voice: mp3 = clips via Recall output_audio (default, proven live); stream = a webpage Recall renders as her
# camera tile (/media/amber): speech streams as it's synthesized (~1-2 s sooner), interruptions cut it instantly, and
# the raised-hand badge shows on her tile. Applies to bots created after the change.
AMBER_VOICE_MODE=mp3
# Raised hand (record question): seconds her tile shows a raised hand before she writes the question in chat
# (someone saying "Amber, go ahead" first makes her ask out loud instead). Streaming voice only.
AMBER_HAND_WAIT=20
# Fillers (English only): one plays only if the answer isn't ready this many seconds after generation starts,
# and at most once per AMBER_FILLER_GAP seconds.
AMBER_FILLER_AFTER=1.2
AMBER_FILLER_GAP=15
# Team timezone as a UTC offset: due dates ("by Friday"), 09:00 reminders and typed meeting times.
# Unset = this machine's zone (wrong on a UTC cloud server).
AMBER_TZ=+05:30
# Conversation with Amber: once she's talking with people, they (and anyone joining the thread) can go on without
# her name. It ends on evidence: "that's all" / "thanks Amber", AMBER_OTHERS_LIMIT lines in a row for other people,
# or AMBER_ENGAGE_IDLE seconds with no exchange. "Amber, join the conversation" keeps her in until "that's all".
AMBER_ENGAGE_IDLE=75
AMBER_OTHERS_LIMIT=3
# 1 = her own voice goes into the Recall recording (debug: did Recall capture what she said?)
AMBER_RECORD_SELF=
